{
  "name": "queuecare",
  "version": "0.1.0",
  "private": true,
  "main": "apps/mobile/index.js",
  "scripts": {
    "start:mobile": "npm --workspace apps/mobile run start",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "ios:mobile": "npm --workspace apps/mobile run ios",
    "lint:mobile": "npm --workspace apps/mobile run lint",
    "typecheck:mobile": "npm --workspace apps/mobile run typecheck",
    "test:mobile": "npm --workspace apps/mobile run test -- --runInBand",
    "android:mobile": "npm --workspace apps/mobile run android",
    "check:mobile": "npm --workspace apps/mobile run check:dependencies",
    "dev:api": "npm --workspace apps/api run dev",
    "start:api": "npm --workspace apps/api run start",
    "test:api": "npm --workspace apps/api run test",
    "db:seed:hospitals": "npm --workspace apps/api run seed:hospitals",
    "db:seed:discovery": "npm --workspace apps/api run seed:discovery",
    "db:seed:sessions": "npm --workspace apps/api run seed:sessions --",
    "check:db": "npm --workspace apps/api run check:db"
  },
  "workspaces": [
    "apps/mobile",
    "apps/api",
    "packages/shared"
  ]
}
