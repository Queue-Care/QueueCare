# Copy to apps/api/.env only when that file does not already exist.
HOST=0.0.0.0
PORT=4000
# Use your development Atlas cluster or a local replica set for booking writes.
MONGODB_URI=mongodb://127.0.0.1:27017/opd_queue
MONGODB_DB_NAME=opd_queue
# Required for patient/staff sign-in: generate a random secret (see docs/SETUP.md).
JWT_SECRET=
JWT_ISSUER=queuecare-api
JWT_AUDIENCE=queuecare-mobile
# Optional for the current local demo; absent keys select MongoDB image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
