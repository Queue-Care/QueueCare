PORT=4000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/opd_queue
MONGODB_DB_NAME=opd_queue
# Booking writes require a replica set (Atlas or local replica set).
# Configure a random secret of at least 32 bytes on the API and login service.
# Leave blank to keep protected booking requests unavailable until configured.
JWT_SECRET=
JWT_ISSUER=queuecare-api
JWT_AUDIENCE=queuecare-mobile
