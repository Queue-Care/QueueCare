{
  "name": "@queuecare/api",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jose": "https://github.com/panva/jose/releases/download/v6.2.12/jose-6.2.12.tgz",
    "mongodb": "^7.7.0",
    "multer": "^2.4.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed:hospitals": "node --env-file-if-exists=.env src/seeds/run.js",
    "seed:discovery": "node --env-file-if-exists=.env src/seeds/run.js --services",
    "seed:sessions": "node --env-file-if-exists=.env src/seeds/run.js --services --sessions",
    "seed:priority": "node --env-file-if-exists=.env src/seeds/run.js --priority",
    "seed:priority:reset": "node --env-file-if-exists=.env src/seeds/run.js --priority --reset-priority",
    "test": "node --test src/tests/*.test.js",
    "check:db": "node --env-file-if-exists=.env src/config/checkDatabase.js"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
