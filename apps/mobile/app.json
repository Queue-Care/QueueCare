{
  "expo": {
    "name": "QueueCare",
    "slug": "queuecare",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "com.queuecare"
    },
    "android": {
      "package": "com.queuecare"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
