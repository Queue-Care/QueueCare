MONGODB_URI=mongodb_connection_string_here
MONGODB_DB_NAME=queuecare
PORT=5000

# API only; configure in apps/api/.env. Never expose to Expo.
JWT_SECRET=
JWT_ISSUER=queuecare-api
JWT_AUDIENCE=queuecare-mobile

# Optional. Profile photos use Cloudinary when these are set (Console > Settings > API Keys);
# otherwise the API keeps them in MongoDB. API only; never expose to Expo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
